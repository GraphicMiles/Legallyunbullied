# Firebase (client SDK config) — copy this file to .env for local dev
# and never commit .env. In Render, set these under the service's
# Environment tab (or fill them in when deploying the render.yaml
# Blueprint, which prompts for each var marked sync: false).
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Groq — used for classification + answer drafting in server/chatRoute.js
# (OpenAI-SDK compatible, hosts open-weight models like Llama on fast inference hardware)
GROQ_API_KEY=
# Optional overrides; defaults live in server/groq.js
# GROQ_MODEL_CLASSIFY=llama-3.1-8b-instant
# GROQ_MODEL_DRAFT=llama-3.3-70b-versatile

# Google Gemini — fallback LLM provider used when Groq rate-limits or fails.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional overrides; defaults live in server/gemini.js
# GEMINI_MODEL_CLASSIFY=gemini-2.0-flash
# GEMINI_MODEL_DRAFT=gemini-2.0-flash

# Firebase Admin SDK — SERVER-SIDE ONLY, genuinely secret (full Firestore/
# Auth/Storage access, bypasses security rules). Generate at Firebase
# Console -> Project Settings -> Service Accounts -> Generate new private
# key, then paste the ENTIRE JSON file contents as a single line here.
FIREBASE_SERVICE_ACCOUNT_JSON=
