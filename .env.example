# Firebase (client SDK config) — copy this file to .env for local dev
# and never commit .env. In Render, set these under the service's
# Environment tab (or fill them in when deploying the render.yaml
# Blueprint, which prompts for each var marked sync: false).
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
