# Firebase Configuration (Required)
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

# Firebase Admin SDK (Required for Firestore)
# Generate from Firebase Console → Project Settings → Service Accounts
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}

# LLM Providers (At least one required - all are FREE, no credit card needed)

# Groq - Fast inference, 14 free models
# Sign up: https://console.groq.com/keys
# Rate limit: ~6,000 tokens/min
GROQ_API_KEY=your_groq_api_key

# OpenRouter - 35+ free models, OpenAI-compatible
# Sign up: https://openrouter.ai/keys
# Rate limit: 200 RPD (requests per day)
OPENROUTER_API_KEY=your_openrouter_api_key

# Cerebras - Ultra-fast on WSE chips, high rate limits
# Sign up: https://cloud.cerebras.ai/
# Rate limit: 1M tokens/day, 14,400 RPD
CEREBRAS_API_KEY=your_cerebras_api_key

# Gemini - Google's LLM, 1M context window
# Sign up: https://aistudio.google.com/app/apikey
# Rate limit: 1,500 req/day (currently returning 503 errors)
GEMINI_API_KEY=your_gemini_api_key

# Model Configuration (Optional - defaults provided)
# GROQ_MODEL_CLASSIFY=openai/gpt-oss-20b
# GROQ_MODEL_DRAFT=openai/gpt-oss-20b
# GROQ_MODEL_REVIEW=openai/gpt-oss-120b
# GROQ_MODEL_DRAFT_FALLBACK=openai/gpt-oss-120b

# OPENROUTER_MODEL_CLASSIFY=meta-llama/llama-3.1-8b-instruct:free
# OPENROUTER_MODEL_DRAFT=meta-llama/llama-3.1-70b-instruct:free

# CEREBRAS_MODEL_CLASSIFY=llama3.1-8b
# CEREBRAS_MODEL_DRAFT=llama3.1-70b

# GEMINI_MODEL_CLASSIFY=gemini-flash-lite-latest
# GEMINI_MODEL_DRAFT=gemini-flash-latest

# Server Configuration
PORT=3000
NODE_ENV=development

# Cache / retrieval configuration
CACHE_TTL_MS=3600000
FIRESTORE_TIMEOUT_MS=5000
# Set false to return an error instead of using the checked-in corpus when Firestore quota/timeouts occur.
LEGAL_CORPUS_LOCAL_FALLBACK=true
MAX_CACHE_SIZE=1000
