# Firebase browser configuration (required)
FIREBASE_API_KEY=your_firebase_web_api_key
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

# Firebase Admin service account JSON on one line (required for auth verification,
# Firestore conversations, jobs, safety acknowledgements and primary corpus reads)
# Paste the downloaded service account JSON as a single line. Values are
# never committed; only this placeholder shape is kept here.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"<account type>","project_id":"<project id>","private_key_id":"<key id>","private_key":"<PEM string, escaped>","client_email":"<service account email>","client_id":"<client id>","token_uri":"https://oauth2.googleapis.com/token"}

# LLM providers (configure Groq and/or Gemini; OpenRouter/Cerebras are optional)
GROQ_API_KEY=your_groq_api_key
GEMINI_API_KEY=your_gemini_api_key
# OPENROUTER_API_KEY=your_openrouter_api_key
# CEREBRAS_API_KEY=your_cerebras_api_key

# Current model defaults; override only with IDs verified by /healthz
# GROQ_MODEL_CLASSIFY=openai/gpt-oss-20b
# GROQ_MODEL_DRAFT=openai/gpt-oss-20b
# GROQ_MODEL_REVIEW=openai/gpt-oss-120b
# GROQ_MODEL_DRAFT_FALLBACK=openai/gpt-oss-120b
# GEMINI_MODEL_CLASSIFY=gemini-flash-lite-latest
# GEMINI_MODEL_DRAFT=gemini-flash-latest

# Server
PORT=3000
NODE_ENV=development

# Firestore retrieval
FIRESTORE_TIMEOUT_MS=5000
LEGAL_CORPUS_LOCAL_FALLBACK=true
# LOCAL_LEGAL_CORPUS=true          # evaluation/development only: bypass Firestore corpus reads
# FEEDBACK_ADMIN_TOKEN=change-me     # owner-only: unlocks GET /api/feedback/export
# TELEMETRY_COLLECTION=telemetry_daily  # default; /api/telemetry/export counters

# Cache stats/invalidate (comma-separated Firebase UIDs). Empty = nobody.
# ADMIN_UIDS=firebaseUid1,firebaseUid2

# Single-process replay worker
JOB_CONCURRENCY=1
# DISABLE_JOB_WORKER=true          # useful for isolated evaluation processes

# Extra CORS origins, comma-separated (exact origins, no wildcards).
# Use this for a Firebase Hosting site or a custom domain.
# ALLOWED_ORIGINS=https://your-app.web.app,https://legallyunbullied.app
