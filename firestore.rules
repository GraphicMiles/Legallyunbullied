rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validConversation(userId) {
      return request.resource.data.userId == userId
        && request.resource.data.keys().hasOnly([
          'userId', 'title', 'createdAt', 'updatedAt'
        ]);
    }

    function validMessage(userId) {
      let data = request.resource.data;
      return data.userId == userId
        && data.role in ['user', 'agent']
        && data.status in [
          'thinking', 'streaming', 'running', 'done', 'casual', 'error',
          'stopped', 'corpusEmpty', 'incomplete', 'needsInput',
          'safetyAck', 'providersBusy'
        ]
        && data.keys().hasOnly([
          'userId', 'role', 'content', 'casualReply', 'status', 'createdAt',
          'startedAt', 'thinkingElapsedMs', 'traceOpen', 'classification',
          'steps', 'result', 'plan', 'corpusEmptyMessage', 'errorMessage',
          'pipelineStatus', 'unread', 'evidence', 'critique',
          'needsInputQuestion', 'needsInputField', 'safetyAckQuestion',
          'safetyAckContext', 'safetyAckToken', 'providersBusyRetryAfter',
          'providersBusyLawMd', 'providersBusyActionsMd',
          'safetyAcknowledgedAt'
        ]);
    }

    // Legal evidence is served by the authenticated server pipeline. Direct
    // browser reads are denied to prevent corpus scraping and quota abuse.
    match /legal_provisions/{document=**} {
      allow read, write: if false;
    }

    match /users/{userId}/conversations/{conversationId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && validConversation(userId);
      allow delete: if isOwner(userId);

      match /messages/{messageId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && validMessage(userId);
        allow delete: if isOwner(userId);
      }
    }

    // Internal collections such as background_jobs and safety_acks are Admin
    // SDK only and remain denied by the catch-all rule.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
